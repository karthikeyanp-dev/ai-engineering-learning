---
import MainLayout from '../../layouts/MainLayout.astro';
import { CoursesDirectory } from '../../components/tools/CoursesDirectory';
---

<MainLayout title="Courses Directory - AI Engineering Learning">
  <div class="py-8">
    <h1 class="text-3xl font-bold mb-2">Courses Directory</h1>
    <p class="text-[var(--color-text-secondary)] mb-8">
      Free and paid courses from top providers to build your AI Engineering skills. Filter by difficulty, provider, or topic.
    </p>
    <CoursesDirectory client:visible />
  </div>
</MainLayout>
