---
import MainLayout from '../../layouts/MainLayout.astro';
import { GithubRepos } from '../../components/tools/GithubRepos';
---

<MainLayout title="GitHub Repositories - AI Engineering Learning">
  <div class="py-8">
    <h1 class="text-3xl font-bold mb-2">GitHub Repositories</h1>
    <p class="text-[var(--color-text-secondary)] mb-8">
      Curated collection of essential GitHub repositories for AI Engineering. From learning resources to production frameworks.
    </p>
    <GithubRepos client:visible />
  </div>
</MainLayout>
