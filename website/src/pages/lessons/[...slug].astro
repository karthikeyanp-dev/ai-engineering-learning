---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { Badge } from '../../components/ui/Badge';
import { MilestoneChecklistIsland, LessonCompleteButtonIsland } from '../../components/progress/Islands';
import { getNextLesson, getPrevLesson, getPhaseForLesson, getLessonUrl, getPhaseUrl } from '../../lib/navigation';
import { findLesson } from '../../lib/curriculum';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, description, phase, objectives, estimatedTime, difficulty, videoUrl } = entry.data;
const slug = entry.id;

// Get navigation data
const prevLesson = getPrevLesson(slug);
const nextLesson = getNextLesson(slug);
const currentPhase = getPhaseForLesson(slug);
const curriculumLesson = findLesson(slug);
const milestones = curriculumLesson?.milestones || [];
const phaseId = currentPhase?.id || `phase-${phase}`;
---

<LessonLayout title={title} description={description}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-6">
    <a href="/" class="hover:text-[var(--color-text-secondary)] transition-colors">Home</a>
    <span>/</span>
    {currentPhase && (
      <a href={getPhaseUrl(currentPhase.id)} class="hover:text-[var(--color-text-secondary)] transition-colors">
        {currentPhase.title}
      </a>
    )}
    <span>/</span>
    <span class="text-[var(--color-text-secondary)]">{title}</span>
  </nav>

  <!-- Lesson metadata header -->
  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <Badge variant="phase" client:load>Phase {phase}</Badge>
      <Badge variant={difficulty} client:load>{difficulty}</Badge>
      <span class="text-xs text-[var(--color-text-muted)] flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {estimatedTime}
      </span>
    </div>
    <h1 class="text-3xl font-bold text-[var(--color-text-primary)] mb-3">{title}</h1>
    <p class="text-[var(--color-text-secondary)] text-lg leading-relaxed">{description}</p>

    {objectives.length > 0 && (
      <div class="mt-6 p-4 rounded-xl bg-[var(--color-bg-secondary)] border border-white/10">
        <h3 class="text-sm font-semibold text-[var(--color-text-primary)] mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-accent-start)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Learning Objectives
        </h3>
        <ul class="space-y-2">
          {objectives.map((obj: string) => (
            <li class="flex items-start gap-2 text-sm text-[var(--color-text-secondary)]">
              <span class="text-[var(--color-accent-start)] mt-1 flex-shrink-0">•</span>
              {obj}
            </li>
          ))}
        </ul>
      </div>
    )}
  </header>

  <!-- MDX Content -->
  <div class="lesson-content">
    <Content />
  </div>

  <!-- Milestones and Completion -->
  <div class="mt-12 space-y-6">
    {milestones.length > 0 && (
      <div class="p-6 rounded-xl bg-[var(--color-bg-secondary)] border border-white/10">
        <MilestoneChecklistIsland
          client:load
          lessonId={slug}
          phaseId={phaseId}
          milestones={milestones}
        />
      </div>
    )}

    <div class="flex justify-center">
      <LessonCompleteButtonIsland client:load lessonId={slug} phaseId={phaseId} />
    </div>
  </div>

  <!-- Previous/Next navigation -->
  <nav class="mt-12 pt-6 border-t border-white/10 flex items-center justify-between">
    {prevLesson ? (
      <a
        href={getLessonUrl(prevLesson.slug)}
        class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        <span>{prevLesson.title}</span>
      </a>
    ) : <div />}

    {nextLesson ? (
      <a
        href={getLessonUrl(nextLesson.slug)}
        class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors group"
      >
        <span>{nextLesson.title}</span>
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    ) : <div />}
  </nav>
</LessonLayout>
